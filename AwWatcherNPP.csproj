<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" />
  <PropertyGroup>
    <Configuration Condition="'$(Configuration)' == ''">Release</Configuration>
    <Platform Condition="'$(Platform)' == ''">x64</Platform>
    <PlatformTarget>$(Platform)</PlatformTarget>
    <OutputType>Library</OutputType>
    <AssemblyName>AwWatcherNPP</AssemblyName>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <OutputPath>bin\$(Platform)\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\$(Platform)\$(Configuration)\</IntermediateOutputPath>
    <Optimize>true</Optimize>
    <WarningLevel>4</WarningLevel>
    <DllExportNamespace>WakaTime</DllExportNamespace>
    <DllExportRootPkg>$(MSBuildProjectDirectory)\.tools\DllExport.1.7.4\</DllExportRootPkg>
    <DllExportOurILAsm>true</DllExportOurILAsm>
    <DllExportPeCheck>2</DllExportPeCheck>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="DllExport">
      <HintPath>$(DllExportRootPkg)gcache\metalib\WakaTime\DllExport.dll</HintPath>
      <Private>False</Private>
    </Reference>
    <Compile Include="src\*.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
  <Import Project="$(DllExportRootPkg)tools\net.r_eg.DllExport.targets" />
</Project>
